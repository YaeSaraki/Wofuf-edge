# =============================================================================
# Wofuf Edge 部署配置 —— 整个项目**唯一**需要改的文件
#
#   cp ops/config.env.example ops/config.env   # 然后按需修改（不要提交这个文件）
#
# 改完：ops/scripts/build.sh && ops/scripts/upload.sh
# =============================================================================

# ───────────────────────── 站点身份 ─────────────────────────
# 站点名（页面标题、导航栏 Logo、页脚）
SERVER_NAME="MCS"
# 副标题
SERVER_TAGLINE="Minecraft Server"
# 服务器核心 / 版本 / 成立年份
SERVER_CORE="Paper"
SERVER_VERSION="26.3"
SERVER_FOUNDED="2024"
# 服务器介绍（留空则用内置文案）
SERVER_INTRO="MCS 是一个基于 Paper 26.3 核心的 Minecraft 服务器，成立于 2024 年。我们致力于为玩家提供稳定、流畅、有趣的游戏环境。"

# ───────────────────────── 界面主题 ─────────────────────────
# 前端的视觉风格，**构建期**决定（改完重新跑 scripts/build.sh 生效）。
# 可选值：
#   memphis —— Memphis 孟菲斯：波点 / 撞色 / 硬投影（默认）
#   liquid-glass —— 液态玻璃：通透玻璃 + 火焰橙，站点原本的样子
# 新增主题：frontend/src/shared/themes/ 里加一份，再在
#           frontend/src/shared/config/theme.ts 登记。
UI_THEME="memphis"

# ───────────────────────── 部署目标 ─────────────────────────
# Cloudflare Workers 上的 Worker 名字
WORKER_NAME="wofuf-edge"
# Cloudflare Pages 上的前端项目名（前端不在本仓库时可不填）
PAGES_PROJECT="wofuf-web"
# Worker 的自定义域名（前端调 API 用这个；workers.dev 在国内被 DNS 污染，别用）
API_HOST="api.example.com"
# 前端的 Pages 自定义域名（用于 CORS 白名单）
PAGES_HOST="www.example.com"

# ───────────────────────── 数据源（Minecraft 插件） ─────────────────────────
# Meowo 插件只读 HTTP 接口的公网地址（经 Cloudflare Tunnel / frp 暴露）
PLUGIN_API_BASE_URL="https://plugin.example.com"

# ───────────────────────── 人机验证（可选） ─────────────────────────
# Cloudflare Turnstile sitekey（公开值）。留空 = 不启用。
# 对应的 secret 用：cd deploy && npx wrangler secret put TURNSTILE_SECRET
TURNSTILE_SITE_KEY=""

# ───────────────────────── Cloudflare 资源 ─────────────────────────
# D1 数据库（`npx wrangler d1 create wofuf-db` 的输出）
D1_DATABASE_NAME="wofuf-db"
D1_DATABASE_ID="00000000-0000-0000-0000-000000000000"
# KV 命名空间（`npx wrangler kv namespace create CACHE` 的输出）
KV_NAMESPACE_ID="00000000000000000000000000000000"
