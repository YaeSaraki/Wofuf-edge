#!/usr/bin/env bash
# =============================================================================
# Wofuf 统一入口
#
#   ./wofuf <命令> [参数]
#
#   login    登录 Cloudflare            logout   退出登录
#   config   查看/修改配置              build    构建部署包
#   upload   上传部署                   update   更新（拉代码→重建→重传）
#   status   状态体检                   doctor   部署前体检（最常用）
#   setup    首次部署向导                deploy   构建 + 上传（一条龙）
#   release  打发布包                    help     看这个
# =============================================================================
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
. "$PROJECT_ROOT/scripts/lib.sh"

CMD="${1:-help}"
shift || true

usage() {
  cat <<'USAGE'
  Wofuf · 运维入口

  用法：./wofuf <命令> [参数]

  ── 账号 ──
    login              登录 Cloudflare（浏览器授权）
    logout             退出登录

  ── 配置 ──
    config show        看全部配置
    config get KEY     看某一项
    config set K V     改某一项
    config unset KEY   删某一项
    config edit        用编辑器打开配置
    config check       校验配置

  ── 构建与部署 ──
    build              按配置构建 Worker + 前端部署包
    upload             上传（worker | frontend 可只传一半）
    deploy             build + upload（一条龙）
    update             拉取最新代码 → 重建 → 重传
    update --check     只看有没有新版本
    update --no-pull   不拉代码，只重建 + 重传

  ── 诊断 ──
    status             当前状态（配置 / API / 插件 / 部署）
    doctor             部署前的完整体检（哪里没配好一目了然）

  ── 发布 ──
    release [版本]     打成发布包 tar.gz
    setup              首次部署向导（配置→登录→构建→上传）
    help               显示本帮助

  例：
    ./wofuf doctor
    ./wofuf config set SERVER_NAME "MyMC"
    ./wofuf deploy
USAGE
}

case "$CMD" in
  help|-h|--help)
    printf '%s\n' "$(usage)"
    ;;

  login|logout|config|build|upload|update|status|release)
    SCRIPT="$PROJECT_ROOT/scripts/$CMD.sh"
    [ -f "$SCRIPT" ] || die "脚本不存在：$SCRIPT"
    exec "$SCRIPT" "$@"
    ;;

  deploy)
    step "构建"
    "$PROJECT_ROOT/scripts/build.sh"
    step "上传"
    "$PROJECT_ROOT/scripts/upload.sh" all
    ;;

  setup)
    step "Wofuf 首次部署向导"
    note ""

    sub "1/4 检查依赖"
    require_cmd node "需要 Node.js"
    require_cmd npm "需要 npm"
    [ -d "$PROJECT_ROOT/node_modules" ] || warn "依赖没装：cd wofuf-edge && npm install（workspaces 会一次装好 backend + frontend）"

    sub "2/4 配置"
    if [ ! -f "$PROJECT_ROOT/config.env" ]; then
      cp "$PROJECT_ROOT/config.env.example" "$PROJECT_ROOT/config.env"
      ok "已创建 config.env"
    fi
    "$PROJECT_ROOT/scripts/config.sh" check || true
    if ask_yes_no "现在编辑配置吗？"; then
      "$PROJECT_ROOT/scripts/config.sh" edit
    fi

    sub "3/4 登录 Cloudflare"
    if ask_yes_no "现在登录 Cloudflare 吗？"; then
      "$PROJECT_ROOT/scripts/login.sh"
    fi

    sub "4/4 构建 + 上传"
    "$PROJECT_ROOT/scripts/build.sh"
    if ask_yes_no "现在上传吗？"; then
      "$PROJECT_ROOT/scripts/upload.sh" all
    else
      note "跳过上传。稍后跑：scripts/upload.sh"
    fi
    ok "向导结束 🎉"
    ;;

  doctor)
    "$PROJECT_ROOT/scripts/doctor.sh" "$@"
    ;;

  *)
    err "未知命令：$CMD"
    printf '\n'
    printf '%s\n' "$(usage)"
    exit 1
    ;;
esac
